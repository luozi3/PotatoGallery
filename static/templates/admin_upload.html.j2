<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set title_sep = site.seo.title_separator or "｜" %}
  <title>上传作品 {{ title_sep }} {{ site_name }}</title>
  <meta name="description" content="{{ site_description }}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {% include "partials/theme_init.html.j2" %}
  <link rel="stylesheet" href="/static/styles/gallery.css?v={{ static_version }}">
</head>
<body class="page-admin page-admin-upload with-sidebar">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  {% set show_search = false %}
  {% set show_admin_logout = true %}
  {% include "partials/topbar.html.j2" %}

  <main id="main-content" tabindex="-1">
    <div class="home-layout">
      {% include "partials/sidebar_default.html.j2" %}
      <div class="home-main">
        <div class="admin-main">
          <section class="admin-auth admin-surface" data-admin-login hidden>
            <h1>需要管理员权限</h1>
            <p class="muted" data-admin-access-message>正在检查登录状态。</p>
            <a class="btn primary" href="/auth/login/" data-admin-access-login hidden>使用用户账号登录</a>
          </section>

          <section class="admin-panel admin-surface admin-upload-panel" data-admin-panel hidden>
            <div class="admin-toolbar admin-hero">
              <div>
                <h1>上传作品</h1>
                <p class="muted">填写完整信息并提交，完成后请到作品管理查看状态。</p>
              </div>
            </div>
            <div class="admin-subnav" aria-label="管理快捷">
              <a class="admin-subnav-link" href="/admin/">管理首页</a>
              <a class="admin-subnav-link" href="/admin/images/">作品管理</a>
              <a class="admin-subnav-link" href="/admin/collections/">分区管理</a>
              <a class="admin-subnav-link" href="/admin/auth/">注册开关</a>
              <a class="admin-subnav-link" href="/admin/tags/">标签管理</a>
              <a class="admin-subnav-link" href="/admin/dmca/">DMCA 处理</a>
              <a class="admin-subnav-link admin-status-link" href="/status/">系统状态</a>
            </div>

            <form class="admin-form" data-admin-upload-form>
              <div class="admin-form-grid">
                <div class="admin-field admin-field-wide">
                  <label class="label">选择图片</label>
                  <input type="file" name="file" accept="image/*" required>
                </div>
                <div class="admin-field">
                  <label class="label">标题</label>
                  <input class="admin-input" type="text" name="title" placeholder="可留空">
                </div>
                <div class="admin-field admin-field-wide">
                  <label class="label">正文说明</label>
                  <textarea class="admin-textarea" name="description" placeholder="描述/注释"></textarea>
                </div>
                <div class="admin-field admin-field-wide">
                  <label class="label">标签</label>
                  <div class="tag-editor" data-tag-editor>
                    <textarea class="admin-tag-input" name="tags" rows="3" placeholder="#tag1 #tag2" data-tag-input data-tag-require-hash="1"></textarea>
                    <div class="tag-editor-meta">
                      <button class="btn ghost" type="button" data-tag-format>整理标签</button>
                      <span class="hint">支持换行/逗号/竖线，点击标签可删除。</span>
                    </div>
                    <div class="tag-editor-chips" data-tag-chips></div>
                  </div>
                  <p class="hint">发布作品需使用 # 标签，选择子标签后会提示补全父标签。</p>
                </div>
                <div class="admin-field">
                  <label class="label">分区</label>
                  <select class="admin-select" name="collection" data-admin-upload-collection>
                    <option value="">自动</option>
                  </select>
                </div>
              </div>
              <div class="admin-actions-row">
                <button class="btn primary" type="submit">开始上传</button>
                <p class="hint" data-admin-upload-hint></p>
              </div>
            </form>

            <section class="admin-surface admin-tag-quick-panel" data-admin-tag-quick>
              <div class="admin-toolbar">
                <div>
                  <h2>快速新增标签</h2>
                  <p class="muted">沿用标签管理的新增流程，保存后可立即用于上传。</p>
                </div>
                <div class="admin-actions">
                  <button class="btn ghost" type="button" data-admin-tag-add>新增标签</button>
                </div>
              </div>
              <div class="tag-admin-guide tag-admin-guide-compact">
                <span>标签名无需 #；别名/父标签支持逗号、竖线或换行。</span>
              </div>
              <div class="tag-admin-shell tag-admin-shell-compact" data-admin-tag-shell>
                <section class="tag-admin-editor tag-admin-editor-compact" data-admin-editor hidden>
                  <div class="tag-admin-editor-head">
                    <div class="tag-admin-editor-title" data-admin-editor-title>新增标签</div>
                    <button class="btn ghost" type="button" data-admin-editor-back>收起</button>
                  </div>
                  <div class="tag-admin-editor-body">
                    <div class="tag-admin-editor-panel" data-admin-editor-panel="tag" data-editor-mode="compact"></div>
                  </div>
                </section>
              </div>
              <p class="hint" data-admin-tags-hint></p>
            </section>

            <section class="admin-surface admin-stress-panel" data-admin-stress-panel>
              <div class="admin-toolbar">
                <div>
                  <h2>压测工具</h2>
                  <p class="muted">随机生成测试图，完成后可一键删除。</p>
                </div>
              </div>
              <div class="admin-form">
                <label class="admin-switch">
                  <input type="checkbox" data-admin-stress-toggle>
                  <span>启用压测操作</span>
                </label>
                <div class="admin-form-grid">
                  <div class="admin-field">
                    <label class="label">生成数量</label>
                    <input class="admin-input" type="number" min="1" max="500" value="40" data-admin-stress-count>
                  </div>
                </div>
                <div class="admin-actions-row">
                  <button class="btn ghost" type="button" data-admin-stress-generate>生成随机图片</button>
                  <button class="btn ghost" type="button" data-admin-stress-stop>停止生成</button>
                  <button class="btn ghost" type="button" data-admin-stress-retry>重试未完成</button>
                  <button class="btn ghost" type="button" data-admin-stress-delete>一键删除压测图片</button>
                  <p class="hint" data-admin-stress-hint></p>
                </div>
              </div>
            </section>
          </section>
        </div>
      </div>
    </div>
  </main>

  <script src="/static/js/ui.js?v={{ static_version }}" defer></script>
  <script src="/static/js/admin.js?v={{ static_version }}" defer></script>
</body>
</html>
