<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set title_sep = site.seo.title_separator or "｜" %}
  <title>注册开关 {{ title_sep }} {{ site_name }}</title>
  <meta name="description" content="{{ site_description }}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {% include "partials/theme_init.html.j2" %}
  <link rel="stylesheet" href="/static/styles/gallery.css?v={{ static_version }}">
</head>
<body class="page-admin page-admin-auth with-sidebar">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  {% set show_search = false %}
  {% set show_admin_logout = true %}
  {% include "partials/topbar.html.j2" %}

  <main id="main-content" tabindex="-1">
    <div class="home-layout">
      {% include "partials/sidebar_default.html.j2" %}
      <div class="home-main">
        <div class="admin-main">
          <section class="admin-auth admin-surface" data-admin-login hidden>
            <h1>管理员登录</h1>
            <p class="muted">请输入后台账号与密码。</p>
            <form class="admin-form" data-admin-login-form>
              <label>账号</label>
              <input type="text" name="username" autocomplete="username" required>
              <label>密码</label>
              <input type="password" name="password" autocomplete="current-password" required>
              <button class="btn primary" type="submit">登录</button>
              <p class="hint" data-admin-login-error></p>
            </form>
          </section>

          <section class="admin-panel admin-surface admin-auth-panel" data-admin-panel hidden>
            <div class="admin-toolbar admin-hero">
              <div>
                <h1>注册开关</h1>
                <p class="muted">选择注册模式并保存，设置将立即生效。</p>
              </div>
            </div>
            <div class="admin-subnav" aria-label="管理快捷">
              <a class="admin-subnav-link" href="/admin/">管理首页</a>
              <a class="admin-subnav-link" href="/admin/images/">作品管理</a>
              <a class="admin-subnav-link" href="/admin/upload/">上传作品</a>
              <a class="admin-subnav-link" href="/admin/collections/">分区管理</a>
              <a class="admin-subnav-link" href="/admin/tags/">标签管理</a>
              <a class="admin-subnav-link" href="/admin/dmca/">DMCA 处理</a>
              <a class="admin-subnav-link admin-status-link" href="/status/">系统状态</a>
            </div>

            <section class="admin-auth-config" data-admin-auth-config>
              <div class="filter-group">
                <span class="label">注册模式</span>
                <select class="select" data-admin-auth-mode>
                  <option value="open">开放注册</option>
                  <option value="closed">关闭注册</option>
                  <option value="invite">邀请码注册</option>
                </select>
              </div>
              <div class="collection-actions">
                <button class="btn primary" type="button" data-admin-auth-save>保存设置</button>
                <p class="hint" data-admin-auth-hint></p>
              </div>
            </section>

            <section class="admin-invite-panel admin-surface" data-admin-invite-panel>
              <div class="admin-toolbar">
                <div>
                  <h2>邀请码管理</h2>
                  <p class="muted">创建后仅显示一次，请及时保存。</p>
                </div>
              </div>
              <div class="admin-invite-created" data-admin-invite-created hidden>
                <span>新邀请码</span>
                <code data-admin-invite-code></code>
              </div>
              <div class="admin-fields-grid admin-invite-form">
                <div class="admin-field">
                  <label class="label">使用范围/备注</label>
                  <input class="admin-input" type="text" placeholder="例如：内部测试或指定群组" data-admin-invite-note>
                </div>
                <div class="admin-field">
                  <label class="label">过期日期</label>
                  <input class="admin-input" type="date" data-admin-invite-expires-at>
                  <p class="hint">默认 0 点，留空表示不过期。</p>
                </div>
                <div class="admin-field">
                  <label class="label">有效天数</label>
                  <input class="admin-input" type="number" min="1" step="1" placeholder="例如 7" data-admin-invite-expires-days>
                  <p class="hint">填写后自动换算过期时间。</p>
                </div>
                <div class="admin-field">
                  <label class="label">使用次数</label>
                  <div class="admin-actions-row">
                    <label class="admin-switch">
                      <input type="checkbox" data-admin-invite-limit checked>
                      启用次数限制
                    </label>
                    <input class="admin-input" type="number" min="1" step="1" placeholder="例如 10" data-admin-invite-max-uses>
                  </div>
                </div>
              </div>
              <div class="admin-actions-row">
                <button class="btn primary" type="button" data-admin-invite-create>生成邀请码</button>
                <button class="btn ghost" type="button" data-admin-invite-refresh>刷新列表</button>
                <p class="hint" data-admin-invite-hint></p>
              </div>
              <div class="admin-invite-list" data-admin-invite-list></div>
              <div class="admin-invite-archive" data-admin-invite-archive>
                <button class="tag-section-toggle" type="button" data-admin-invite-archive-toggle aria-expanded="false">
                  <span>已停用邀请码</span>
                  <span class="tag-section-meta" data-admin-invite-archive-count></span>
                </button>
                <div class="admin-invite-list admin-invite-archived" data-admin-invite-archive-list hidden></div>
              </div>
            </section>
          </section>
        </div>
      </div>
    </div>
  </main>

  <div class="admin-dialog" data-admin-invite-dialog aria-hidden="true">
    <div class="admin-dialog-backdrop" data-admin-invite-dialog-close></div>
    <div class="admin-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="invite-dialog-title">
      <div class="admin-dialog-head">
        <h3 id="invite-dialog-title" class="admin-dialog-title">处理邀请码</h3>
        <button class="icon-button admin-dialog-close" type="button" data-admin-invite-dialog-close aria-label="关闭弹窗">x</button>
      </div>
      <p class="muted admin-dialog-desc" data-admin-invite-dialog-desc>请选择对该邀请码的操作。</p>
      <div class="admin-dialog-actions">
        <button class="btn primary" type="button" data-admin-invite-dialog-disable>停用</button>
        <button class="btn danger" type="button" data-admin-invite-dialog-delete>删除</button>
        <button class="btn ghost" type="button" data-admin-invite-dialog-cancel>取消</button>
      </div>
    </div>
  </div>

  <script src="/static/js/ui.js?v={{ static_version }}" defer></script>
  <script src="/static/js/admin.js?v={{ static_version }}" defer></script>
</body>
</html>
