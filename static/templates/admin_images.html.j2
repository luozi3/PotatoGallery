<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set title_sep = site.seo.title_separator or "｜" %}
  <title>作品管理 {{ title_sep }} {{ site_name }}</title>
  <meta name="description" content="{{ site_description }}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {% include "partials/theme_init.html.j2" %}
  <link rel="stylesheet" href="/static/styles/gallery.css?v={{ static_version }}">
</head>
<body class="page-admin page-admin-images page-admin-dashboard with-sidebar">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  {% set show_search = false %}
  {% set show_admin_logout = true %}
  {% include "partials/topbar.html.j2" %}

  <main id="main-content" tabindex="-1">
    <div class="home-layout">
      {% include "partials/sidebar_default.html.j2" %}
      <div class="home-main">
        <div class="admin-main">
          <section class="admin-auth admin-surface" data-admin-login hidden>
            <h1>需要管理员权限</h1>
            <p class="muted" data-admin-access-message>正在检查登录状态。</p>
            <a class="btn primary" href="/auth/login/" data-admin-access-login hidden>使用用户账号登录</a>
          </section>

          <section class="admin-panel admin-surface admin-images-panel" data-admin-panel hidden>
            <div class="admin-toolbar admin-hero">
              <div>
                <h1>作品管理</h1>
                <p class="muted">修改后会自动触发静态刷新，生效有少量延迟。</p>
              </div>
              <div class="admin-actions">
                <button class="btn ghost" type="button" data-admin-refresh>刷新列表</button>
                <button class="btn ghost" type="button" data-admin-toggle-trash>查看垃圾桶</button>
                <button class="btn ghost danger" type="button" data-admin-trash-page hidden>删除本页垃圾</button>
                <button class="btn ghost danger" type="button" data-admin-trash-all hidden>清空垃圾桶</button>
                <span class="admin-trash-hint muted" data-admin-trash-hint hidden></span>
              </div>
            </div>
            <div class="admin-subnav" aria-label="管理快捷">
              <a class="admin-subnav-link" href="/admin/">管理首页</a>
              <a class="admin-subnav-link" href="/admin/upload/">上传作品</a>
              <a class="admin-subnav-link" href="/admin/collections/">分区管理</a>
              <a class="admin-subnav-link" href="/admin/auth/">注册开关</a>
              <a class="admin-subnav-link" href="/admin/tags/">标签管理</a>
              <a class="admin-subnav-link" href="/admin/dmca/">DMCA 处理</a>
              <a class="admin-subnav-link admin-status-link" href="/status/">系统状态</a>
            </div>

            <section class="admin-controls admin-controls-card">
              <input class="admin-search" type="search" placeholder="搜索标题 / 描述 / 标签" data-admin-query data-search-input>
              <select class="select" data-admin-collection-filter>
                <option value="all">全部分区</option>
                {% for collection in collections_list %}
                <option value="{{ collection.slug }}">{{ collection.title }}</option>
                {% endfor %}
              </select>
            </section>

            <div class="admin-pagination admin-pagination-top" data-admin-pagination-top hidden>
              <button class="btn ghost" type="button" data-admin-page-prev>上一页</button>
              <div class="admin-page-list" data-admin-page-list></div>
              <button class="btn ghost" type="button" data-admin-page-next>下一页</button>
              <div class="admin-page-summary" data-admin-page-summary>共 1 页 / 共 0 张</div>
              <label class="admin-page-jump">
                <span>跳转</span>
                <input class="admin-input" type="number" min="1" step="1" inputmode="numeric" data-admin-page-input>
              </label>
              <button class="btn ghost" type="button" data-admin-page-jump>确定</button>
            </div>

            <section class="gallery admin-gallery" data-admin-grid aria-live="polite"></section>
            <div class="empty" data-admin-empty>当前暂无作品。</div>
            <div class="admin-pagination" data-admin-pagination hidden>
              <button class="btn ghost" type="button" data-admin-page-prev>上一页</button>
              <div class="admin-page-list" data-admin-page-list></div>
              <button class="btn ghost" type="button" data-admin-page-next>下一页</button>
              <div class="admin-page-summary" data-admin-page-summary>共 1 页 / 共 0 张</div>
              <label class="admin-page-jump">
                <span>跳转</span>
                <input class="admin-input" type="number" min="1" step="1" inputmode="numeric" data-admin-page-input>
              </label>
              <button class="btn ghost" type="button" data-admin-page-jump>确定</button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <script src="/static/js/ui.js?v={{ static_version }}" defer></script>
  <script src="/static/js/admin.js?v={{ static_version }}" defer></script>
</body>
</html>
