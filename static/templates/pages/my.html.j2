<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set title_sep = site.seo.title_separator or "｜" %}
  <title>我的作品 {{ title_sep }} {{ site_name }}</title>
  <meta name="description" content="{{ site_description }}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {% include "partials/theme_init.html.j2" %}
  <link rel="stylesheet" href="/static/styles/gallery.css?v={{ static_version }}">
</head>
<body class="page-my with-sidebar" data-user-page>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  {% include "partials/topbar.html.j2" %}

  <main id="main-content" tabindex="-1">
    <div class="home-layout">
      {% include "partials/sidebar_default.html.j2" %}
      <div class="home-main">
        <div class="admin-main">
          <section class="admin-toolbar">
            <div>
              <h2>我的作品列表</h2>
              <p class="muted" data-user-login-hint>未登录时无法加载。</p>
            </div>
          </section>
          <section class="admin-controls admin-controls-card">
            <input class="admin-search" type="search" placeholder="搜索标题 / 描述 / 标签" data-user-query data-search-input>
            <select class="select" data-user-collection-filter>
              <option value="all">全部分区</option>
              {% for collection in collections_list %}
              <option value="{{ collection.slug }}">{{ collection.title }}</option>
              {% endfor %}
            </select>
          </section>

          <div class="admin-pagination admin-pagination-top" data-user-pagination-top hidden>
            <button class="btn ghost" type="button" data-user-page-prev>上一页</button>
            <div class="admin-page-list" data-user-page-list></div>
            <button class="btn ghost" type="button" data-user-page-next>下一页</button>
            <div class="admin-page-summary" data-user-page-summary>共 1 页 / 共 0 张</div>
            <label class="admin-page-jump">
              <span>跳转</span>
              <input class="admin-input" type="number" min="1" step="1" inputmode="numeric" data-user-page-input>
            </label>
            <button class="btn ghost" type="button" data-user-page-jump>确定</button>
          </div>
          <section class="gallery user-gallery" data-user-gallery data-masonry aria-live="polite"></section>
          <div class="empty" data-user-empty>暂无作品，去上传页面添加吧。</div>
          <div class="admin-pagination" data-user-pagination hidden>
            <button class="btn ghost" type="button" data-user-page-prev>上一页</button>
            <div class="admin-page-list" data-user-page-list></div>
            <button class="btn ghost" type="button" data-user-page-next>下一页</button>
            <div class="admin-page-summary" data-user-page-summary>共 1 页 / 共 0 张</div>
            <label class="admin-page-jump">
              <span>跳转</span>
              <input class="admin-input" type="number" min="1" step="1" inputmode="numeric" data-user-page-input>
            </label>
            <button class="btn ghost" type="button" data-user-page-jump>确定</button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="/static/js/ui.js?v={{ static_version }}" defer></script>
  <script src="/static/js/user.js?v={{ static_version }}" defer></script>
</body>
</html>
