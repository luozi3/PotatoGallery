<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set title_sep = site.seo.title_separator or "｜" %}
  <title>用户登录 {{ title_sep }} {{ site_name }}</title>
  <meta name="description" content="{{ site_description }}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {% include "partials/theme_init.html.j2" %}
  <link rel="stylesheet" href="/static/styles/gallery.css?v={{ static_version }}">
</head>
<body class="page-auth with-sidebar" data-auth-mode="{{ auth.registration_mode }}" data-auth-require-https="{{ 1 if auth.require_https else 0 }}">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  {% set show_search = false %}
  {% include "partials/topbar.html.j2" %}

  <main id="main-content" tabindex="-1">
    <div class="home-layout">
      {% include "partials/sidebar_default.html.j2" %}
      <div class="home-main">
        <div class="auth-main">
          <section class="card auth-card">
            <h1>用户登录</h1>
            <p class="muted">账号与密码仅用于访问用户功能。</p>
            {% set session_days = auth.session_days | int %}
            {% set remember_days = session_days if session_days in [1, 7, 30, 60] else 7 %}
            <form class="admin-form" data-auth-login-form>
              <label>账号</label>
              <input type="text" name="username" autocomplete="username" required>
              <label>密码</label>
              <input type="password" name="password" autocomplete="current-password" required>
              <div class="auth-remember" data-auth-remember>
                <label class="auth-remember-toggle">
                  <input type="checkbox" name="remember_device" value="1" data-auth-remember-check>
                  <span>记住本设备登录状态</span>
                </label>
                <div class="auth-remember-panel" data-auth-remember-panel>
                  <p class="auth-remember-title">记忆时长</p>
                  <div class="auth-remember-options">
                    <label class="auth-option">
                      <input type="radio" name="session_days" value="1" {% if remember_days == 1 %}checked{% endif %}>
                      <span>1 天</span>
                    </label>
                    <label class="auth-option">
                      <input type="radio" name="session_days" value="7" {% if remember_days == 7 %}checked{% endif %}>
                      <span>7 天</span>
                    </label>
                    <label class="auth-option">
                      <input type="radio" name="session_days" value="30" {% if remember_days == 30 %}checked{% endif %}>
                      <span>30 天</span>
                    </label>
                    <label class="auth-option">
                      <input type="radio" name="session_days" value="60" {% if remember_days == 60 %}checked{% endif %}>
                      <span>60 天</span>
                    </label>
                  </div>
                  <p class="auth-remember-note">勾选后将保持登录状态，过期自动退出。</p>
                </div>
              </div>
              <button class="btn primary" type="submit">登录</button>
              <p class="muted auth-terms">登录即表示你同意<a href="/legal/#tos">用户协议</a>与<a href="/legal/#privacy">隐私政策</a>。</p>
              <p class="hint" data-auth-login-error></p>
            </form>
            {% if auth.registration_mode != "closed" %}
            <p class="muted auth-switch">没有账号？<a href="/auth/register/">去注册</a></p>
            {% endif %}
          </section>
        </div>
      </div>
    </div>
  </main>

  <script src="/static/js/ui.js?v={{ static_version }}" defer></script>
  <script src="/static/js/auth.js?v={{ static_version }}" defer></script>
</body>
</html>
